{
  "name": "integralo",
  "version": "0.1.0",
  "private": true,
  "description": "IntegrAlo: modular local platform for supervision and control",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "check:manifests": "node packages/contract/dist/cli/check-manifests.js modules",
    "start": "pnpm --filter @integralo/supervisor start",
    "server": "pnpm --filter @integralo/server start",
    "client": "pnpm --filter @integralo/client start",
    "sim-node": "pnpm --filter @integralo/sim-node start",
    "simulate": "pnpm --filter @integralo/sim-node simulate",
    "e2e": "pnpm -r --workspace-concurrency=1 --if-present e2e",
    "package": "node scripts/package.mjs"
  }
}
