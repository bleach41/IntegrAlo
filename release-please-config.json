{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "Novedades" },
    { "type": "fix", "section": "Correcciones" },
    { "type": "perf", "section": "Rendimiento" },
    { "type": "docs", "section": "Documentación" },
    { "type": "build", "section": "Instalador y compilación", "hidden": true },
    { "type": "test", "section": "Pruebas", "hidden": true },
    { "type": "refactor", "section": "Reorganización interna", "hidden": true },
    { "type": "chore", "section": "Mantenimiento", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "integralo",
      "initial-version": "0.1.0"
    }
  }
}
